# ========================================
# Frontend Environment Variables Example
# ========================================

# API Server URL (Backend API endpoint)
VITE_SERVER_URL=http://localhost:5000

# WebSocket URL (Real-time communication)
VITE_SOCKET_URL=ws://localhost:5000

# ========================================
# Development Environment
# ========================================
# VITE_SERVER_URL=http://localhost:5000
# VITE_SOCKET_URL=ws://localhost:5000

# ========================================
# Production Environment
# ========================================
# VITE_SERVER_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=wss://api.yourdomain.com

# ========================================
# Docker Environment
# ========================================
# VITE_SERVER_URL=http://backend:5000
# VITE_SOCKET_URL=ws://backend:5000 