# ========================================
# MongoDB Development Environment Example
# ========================================

# MongoDB Root User (開発環境用)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password

# MongoDB Application User (開発環境用)
MONGO_APP_USERNAME=werewolf_user
MONGO_APP_PASSWORD=werewolf_password

# MongoDB Database
MONGO_INITDB_DATABASE=werewolf 