# ========================================
# MongoDB Production Environment
# ========================================

# MongoDB Root User (本番環境用)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=werewolf_secure_password_2024

# MongoDB Application User (本番環境用)
MONGO_APP_USERNAME=werewolf_user
MONGO_APP_PASSWORD=werewolf_app_secure_password_2024

# MongoDB Database
MONGO_INITDB_DATABASE=werewolf

# MongoDB Express (管理画面)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=werewolf_express_password_2024

# ========================================
# Node.js Application Environment
# ========================================

# アプリケーション設定
NODE_ENV=production
PORT=3000

# MongoDB接続文字列
MONGODB_URI=mongodb://werewolf_user:werewolf_app_secure_password_2024@localhost:27017/werewolf?authSource=werewolf

# JWT設定
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# メール設定
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@gmail.com

# フロントエンドURL
FRONTEND_URL=http://54.199.89.153

# セキュリティ設定
CORS_ORIGIN=http://54.199.89.153 